[node name="NameLabel" type="Label"
 parent="CanvasLayer/RootUI/TopBandHBox/RightEdgePopoutsVBox/AgesPopout/AgesPanel/AgesMargin/AgesVBox/WorldButton/BtnVBox"
 unique_id=2200000011]
layout_mode = 2
size_flags_vertical = 3
mouse_filter = 2
horizontal_alignment = 1
vertical_alignment = 1
text = "WORLD"
theme_override_font_sizes/font_size = 14

[node name="SubLabel" type="Label"
