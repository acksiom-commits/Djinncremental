; ============================================================
; root_ui.gd addition — in _ready(), alongside the journal:
;
;     _ages_popout = find_child("AgesPopout", true, false)
;     if not _ages_popout:
;         push_warning("RootUI: AgesPopout not found")
;
; To wire an age_selected signal handler:
;
;     if _ages_popout:
;         _ages_popout.age_selected.connect(_on_age_selected)
;
; func _on_age_selected(key: String) -> void:
;     pass  # route to game_data / game_context as needed
;
; To reveal and unlock at the appropriate milestone:
;
;     if _ages_popout:
;         _ages_popout.reveal()
;         _ages_popout.unlock_age("firmament")
;         _ages_popout.set_active_age("firmament")
; ============================================================
